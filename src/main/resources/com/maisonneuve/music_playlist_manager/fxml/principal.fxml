<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.maisonneuve.music_playlist_manager.controller.PrincipalController">
    <center>
        <VBox fx:id="filterListContainer" prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
            <children>
                <HBox fx:id="filterContainer" alignment="CENTER" prefHeight="70.0" prefWidth="600.0" spacing="12.0">
                    <children>
                        <VBox spacing="4.0">
                            <children>
                                <Label text="Recherche" />
                                <TextField fx:id="searchField" prefHeight="25.0" prefWidth="124.0" />
                            </children>
                        </VBox>
                        <VBox spacing="4.0">
                            <children>
                                <Label text="Genre" />
                                <ComboBox fx:id="genreFilter" prefHeight="25.0" prefWidth="100.0" promptText="Tous" />
                            </children>
                        </VBox>
                        <VBox spacing="4.0">
                            <children>
                                <Label text="Décennie" />
                                <ComboBox fx:id="decennieFilter" prefHeight="25.0" prefWidth="100.0" promptText="Toutes" />
                            </children>
                        </VBox>
                        <VBox spacing="4.0">
                            <children>
                                <Label text="Année" />
                                <ComboBox fx:id="releaseYearFilter" prefHeight="25.0" prefWidth="90.0" promptText="Toutes" />
                            </children>
                        </VBox>
                    </children>
                    <VBox.margin>
                        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                    </VBox.margin>
                </HBox>
                <TableView fx:id="tableSongList">
                    <columns>
                        <TableColumn fx:id="titleColumn" prefWidth="150.0" text="Titre" />
                        <TableColumn fx:id="artistColumn" prefWidth="120.0" text="Artiste" />
                        <TableColumn fx:id="genreColumn" prefWidth="95.0" text="Genre" />
                        <TableColumn fx:id="releaseYearColumn" prefWidth="70.0" text="Année" />
                        <TableColumn fx:id="durationColumn" prefWidth="70.0" text="Durée" />
                        <TableColumn fx:id="listenCountColumn" prefWidth="95.0" text="Écoutes" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                <HBox alignment="CENTER" prefHeight="40.0" prefWidth="491.0">
                    <children>
                        <Button fx:id="btnPrevious" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Précédent">
                            <HBox.margin>
                                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                            </HBox.margin>
                        </Button>
                        <Label fx:id="lblPage" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="Label">
                            <padding>
                                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                            </padding>
                        </Label>
                        <Button fx:id="btnNext" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="suivant">
                            <HBox.margin>
                                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                            </HBox.margin>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="64.0" prefWidth="600.0" spacing="12.0" BorderPane.alignment="CENTER">
            <children>
                <ImageView fx:id="logo" fitHeight="36.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../assets/Spotify_Primary_Logo_RGB_Green.png" />
                    </image>
                </ImageView>
                <Label fx:id="titleLabel" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Spotify Playlist Manager" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="benchmarkButton" mnemonicParsing="false" text="Benchmark" />
            </children>
            <padding>
                <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
            </padding>
        </HBox>
    </top>
    <left>
        <VBox fx:id="sortContainer" prefHeight="327.0" prefWidth="117.0" spacing="8.0" BorderPane.alignment="CENTER">
            <children>
                <Label text="Tri" />
                <ComboBox fx:id="sortCriterionChoice" prefWidth="140.0" promptText="Trier par" />
                <ComboBox fx:id="sortOrderChoice" prefWidth="140.0" promptText="Ordre" />
                <ComboBox fx:id="sortAlgorithmChoice" prefWidth="140.0" promptText="Algorithme" />
                <Button fx:id="sortButton" mnemonicParsing="false" prefWidth="140.0" text="Trier" />
            </children>
            <BorderPane.margin>
                <Insets />
            </BorderPane.margin>
            <padding>
                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
            </padding>
        </VBox>
    </left>
    <right>
        <VBox fx:id="songDetailBox" prefWidth="220.0" spacing="10.0" BorderPane.alignment="CENTER">
            <children>
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Chanson sélectionnée" />
                <Label fx:id="selectedSongTitleLabel" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Aucune chanson" />
                <Label fx:id="selectedSongArtistLabel" text="Artiste: -" />
                <Label fx:id="selectedSongAlbumLabel" text="Album: -" />
                <Label fx:id="selectedSongGenreLabel" text="Genre: -" />
                <Label fx:id="selectedSongReleaseYearLabel" text="Année: -" />
                <Label fx:id="selectedSongDurationLabel" text="Durée: -" />
                <Label fx:id="selectedSongListenCountLabel" text="Écoutes: -" />
                <Button fx:id="addSelectedSongToPlaylistButton" mnemonicParsing="false" prefWidth="180.0" text="Ajouter à une playlist" />
            </children>
            <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
            </padding>
        </VBox>
    </right>
   <bottom>
      <HBox fx:id="steamSongBox" prefHeight="61.0" prefWidth="600.0" BorderPane.alignment="CENTER" />
   </bottom>
</BorderPane>
