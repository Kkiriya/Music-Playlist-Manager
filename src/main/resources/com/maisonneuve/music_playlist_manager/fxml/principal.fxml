<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.maisonneuve.music_playlist_manager.controller.PrincipalController">
    <center>
        <VBox fx:id="mainContentBox" spacing="10.0" BorderPane.alignment="CENTER">
            <children>
                <VBox fx:id="filterContainer" spacing="8.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <VBox spacing="4.0">
                                    <children>
                                        <Label text="Recherche" />
                                        <TextField fx:id="searchField" prefHeight="25.0" prefWidth="170.0" promptText="Titre ou artiste" />
                                    </children>
                                </VBox>
                                <VBox spacing="4.0">
                                    <children>
                                        <Label text="Genre" />
                                        <ComboBox fx:id="genreFilter" prefHeight="25.0" prefWidth="120.0" promptText="Tous" />
                                    </children>
                                </VBox>
                                <VBox spacing="4.0">
                                    <children>
                                        <Label text="Décennie" />
                                        <ComboBox fx:id="decennieFilter" prefHeight="25.0" prefWidth="120.0" promptText="Toutes" />
                                    </children>
                                </VBox>
                                <VBox spacing="4.0">
                                    <children>
                                        <Label text="Artiste" />
                                        <ComboBox fx:id="artistFilter" prefHeight="25.0" prefWidth="150.0" promptText="Tous" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <VBox spacing="4.0">
                                    <children>
                                        <Label text="Durée max" />
                                        <Slider fx:id="maxDurationSlider" blockIncrement="30.0" majorTickUnit="60.0" max="600.0" prefWidth="220.0" showTickLabels="true" showTickMarks="true" value="600.0" />
                                    </children>
                                </VBox>
                                <VBox spacing="4.0">
                                    <children>
                                        <Label text="Écoutes min" />
                                        <Slider fx:id="minListenCountSlider" blockIncrement="100.0" majorTickUnit="1000.0" max="10000.0" prefWidth="220.0" showTickLabels="true" showTickMarks="true" />
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="resetFiltersButton" mnemonicParsing="false" text="Réinitialiser" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <TableView fx:id="tableSongList" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="titleColumn" prefWidth="150.0" text="Titre" />
                        <TableColumn fx:id="artistColumn" prefWidth="120.0" text="Artiste" />
                        <TableColumn fx:id="genreColumn" prefWidth="95.0" text="Genre" />
                        <TableColumn fx:id="releaseYearColumn" prefWidth="70.0" text="Année" />
                        <TableColumn fx:id="durationColumn" prefWidth="70.0" text="Durée" />
                        <TableColumn fx:id="listenCountColumn" prefWidth="95.0" text="Écoutes" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                <HBox alignment="CENTER" spacing="12.0">
                    <children>
                        <Button fx:id="btnPrevious" mnemonicParsing="false" text="Précédent" />
                        <Label fx:id="lblPage" text="Page 1 / 1" />
                        <Button fx:id="btnNext" mnemonicParsing="false" text="Suivant" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="Par page" />
                        <ComboBox fx:id="pageSizeComboBox" prefWidth="80.0" promptText="25" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
            </padding>
        </VBox>
    </center>
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="64.0" prefWidth="600.0" spacing="12.0" BorderPane.alignment="CENTER">
            <children>
                <ImageView fx:id="logo" fitHeight="36.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../assets/Spotify_Primary_Logo_RGB_Green.png" />
                    </image>
                </ImageView>
                <Label fx:id="titleLabel" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Spotify Playlist Manager" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="benchmarkButton" mnemonicParsing="false" text="Benchmark" />
            </children>
            <padding>
                <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
            </padding>
        </HBox>
    </top>
    <left>
        <VBox fx:id="sortContainer" prefWidth="170.0" spacing="10.0" BorderPane.alignment="CENTER">
            <children>
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Tri" />
                <VBox spacing="4.0">
                    <children>
                        <Label text="Critère" />
                        <ComboBox fx:id="sortCriterionChoice" prefWidth="150.0" promptText="Trier par" />
                    </children>
                </VBox>
                <VBox spacing="4.0">
                    <children>
                        <Label text="Ordre" />
                        <ComboBox fx:id="sortOrderChoice" prefWidth="150.0" promptText="Ordre" />
                    </children>
                </VBox>
                <VBox spacing="4.0">
                    <children>
                        <Label text="Algorithme" />
                        <ComboBox fx:id="sortAlgorithmChoice" prefWidth="150.0" promptText="Algorithme" />
                    </children>
                </VBox>
                <Button fx:id="sortButton" mnemonicParsing="false" prefWidth="150.0" text="Trier" />
            </children>
            <BorderPane.margin>
                <Insets />
            </BorderPane.margin>
            <padding>
                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
            </padding>
        </VBox>
    </left>
    <right>
        <VBox fx:id="songDetailBox" prefWidth="220.0" spacing="10.0" BorderPane.alignment="CENTER">
            <children>
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Chanson sélectionnée" />
                <Label fx:id="selectedSongTitleLabel" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Aucune chanson" />
                <Label fx:id="selectedSongArtistLabel" text="Artiste: -" />
                <Label fx:id="selectedSongAlbumLabel" text="Album: -" />
                <Label fx:id="selectedSongGenreLabel" text="Genre: -" />
                <Label fx:id="selectedSongReleaseYearLabel" text="Année: -" />
                <Label fx:id="selectedSongDurationLabel" text="Durée: -" />
                <Label fx:id="selectedSongListenCountLabel" text="Écoutes: -" />
                <Button fx:id="addSelectedSongToPlaylistButton" mnemonicParsing="false" prefWidth="180.0" text="Ajouter à une playlist" />
            </children>
            <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
            </padding>
        </VBox>
    </right>
    <bottom>
        <HBox fx:id="playerBox" alignment="CENTER_LEFT" prefHeight="76.0" prefWidth="600.0" spacing="16.0" BorderPane.alignment="CENTER">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label fx:id="currentSongTitleLabel" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Aucune chanson en cours" />
                        <Label fx:id="currentSongArtistLabel" text="Artiste: -" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="previousTrackButton" mnemonicParsing="false" prefHeight="32.0" prefWidth="40.0" text="⏪">
                    <tooltip>
                        <Tooltip text="Précédent" />
                    </tooltip>
                </Button>
                <Button fx:id="playPauseButton" mnemonicParsing="false" prefHeight="32.0" prefWidth="40.0" text="▶️">
                    <tooltip>
                        <Tooltip text="Lecture / pause" />
                    </tooltip>
                </Button>
                <Button fx:id="nextTrackButton" mnemonicParsing="false" prefHeight="32.0" prefWidth="40.0" text="⏩">
                    <tooltip>
                        <Tooltip text="Suivant" />
                    </tooltip>
                </Button>
                <Button fx:id="shuffleButton" mnemonicParsing="false" prefHeight="32.0" prefWidth="40.0" text="🔀">
                    <tooltip>
                        <Tooltip text="Lecture aléatoire" />
                    </tooltip>
                </Button>
                <Slider fx:id="playbackProgressSlider" prefWidth="160.0" />
            </children>
            <padding>
                <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
            </padding>
        </HBox>
    </bottom>
</BorderPane>
